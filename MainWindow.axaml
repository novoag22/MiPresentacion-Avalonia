<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MiPresentacion.MainWindow"
        Title="MiPresentacion - Avalonia UI"
        Width="450" Height="460"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="25" Spacing="12">
        <!-- Título principal -->
        <TextBlock Text="Mi primera aplicación gráfica"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <!-- Campos de entrada -->
        <TextBlock Text="Nombre:"/>
        <TextBox x:Name="TxtNombre" Watermark="Escribe tu nombre"/>

        <TextBlock Text="Apellido:"/>
        <TextBox x:Name="TxtApellido" Watermark="Escribe tu apellido"/>

        <TextBlock Text="Edad:"/>
        <TextBox x:Name="TxtEdad" Watermark="Escribe tu edad (ej. 20)"/>

        <!-- Botones de acción (incluye el reto adicional 'Cambiar saludo') -->
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,5">
            <Button x:Name="BtnPresentarme" Content="Presentarme" Click="BtnPresentarme_Click"/>
            <Button x:Name="BtnCambiarSaludo" Content="Cambiar saludo" Click="BtnCambiarSaludo_Click"/>
            <Button x:Name="BtnLimpiar" Content="Limpiar" Click="BtnLimpiar_Click"/>
        </StackPanel>

        <!-- Área de resultado -->
        <TextBlock x:Name="TxtResultado"
                   Text="Completa tus datos y presiona Presentarme."
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,10,0,0"/>
    </StackPanel>
</Window>